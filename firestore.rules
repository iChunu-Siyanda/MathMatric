rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Student Curriculum Data:
    // ============================================================
    match /curriculum/{mathmatric}/{curriculumId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Matches all subcollections: bundles, subjects, topics, levels, questions, examPapers
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    match /curriculum/{mathslitmatric}/{curriculumId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Matches all subcollections: bundles, subjects, topics, levels, questions, examPapers
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // ============================================================
    // Student Accounts
    // ============================================================

    match /studentAccounts/{studentId} {

      // Students may read their own account.
      allow read: if request.auth != null && request.auth.uid == studentId;

      // Account creation/update is handled by Cloud Functions.
      allow write: if false;
    }

    // ============================================================
    // PURE MATHEMATICS STUDENTS:
    // ============================================================

    match /students/pure_maths_students/users/{studentId} {

      // Student's own profile/root document
      allow read, write: if request.auth != null
        && request.auth.uid == studentId;

      match /questionAttempts/{attemptId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /userLevelProgresses/{progressId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /userTopicProgresses/{progressId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /studySessions/{sessionId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }
    }


    // ============================================================
    // MATHEMATICAL LITERACY STUDENTS:
    // ============================================================

    match /students/maths_literacy_students/users/{studentId} {

      // Student's own profile/root document
      allow read, write: if request.auth != null
        && request.auth.uid == studentId;

      match /questionAttempts/{attemptId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /userLevelProgresses/{progressId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /userTopicProgresses/{progressId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }

      match /studySessions/{sessionId} {
        allow read, write: if request.auth != null
          && request.auth.uid == studentId;
      }
    }

    // ============================================================
    // Student Notifications:
    // ============================================================

    match /notifications/{notificationId} {
      // Students can only read their own notifications.
      allow read: if request.auth != null
                  && resource.data.studentId == request.auth.uid;

      // Notifications are created by trusted backend code only.
      allow create: if false;

      // Students may only mark their own notification as read.
      allow update: if request.auth != null
                    && resource.data.studentId == request.auth.uid
                    && request.resource.data.studentId == resource.data.studentId
                    && request.resource.data.type == resource.data.type
                    && request.resource.data.title == resource.data.title
                    && request.resource.data.body == resource.data.body
                    && request.resource.data.target == resource.data.target
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.expiresAt == resource.data.expiresAt
                    && resource.data.readAt == null
                    && request.resource.data.readAt != null;

      // Students should never delete notifications.
      allow delete: if false;
    }

    // ============================================================
    // Student Devices:
    // ============================================================

    match /students/{studentType}/users/{studentId}/devices/{deviceId} {

      // Device registration/unregistration is handled by
      // Cloud Functions. Clients should NEVER access these directly.
      allow read, write: if false;
    }

    // ============================================================
    // Tutor Notifications:
    // ============================================================

    match /tutorNotifications/{notificationId} {

      // Tutors can read only their own notifications.
      allow read: if request.auth != null
        && resource.data.tutorId == request.auth.uid;

      // Notification documents are created by Cloud Functions.
      allow create: if false;

      // Tutors may only mark their own notification as read.
      allow update: if request.auth != null
        && resource.data.tutorId == request.auth.uid
        && request.resource.data.tutorId == resource.data.tutorId
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && request.resource.data.body == resource.data.body
        && request.resource.data.target == resource.data.target
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && resource.data.readAt == null
        && request.resource.data.readAt != null

      // Tutors cannot delete notifications.
      allow delete: if false;
    }

    // ============================================================
    // Tutor Devices:
    // ============================================================

    match /tutors/{tutorId}/devices/{deviceId} {

      // Device registration/unregistration is handled by
      // Cloud Functions.
      allow read, write: if false;
    }

  }
}
