rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Curriculum Data (Nested under /curriculum/{curriculumId}/...)
    match /curriculum/{curriculumId} {
      allow read: if request.auth != null;
      allow write: if false;

      // Matches all subcollections: bundles, subjects, topics, levels, questions, examPapers
      match /{allSubcollections=**} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // 2. User Data (Nested under /userdata/{userId}/...)
    //match /userdata/{userId} {
    //  allow read, write: if request.auth != null && request.auth.uid == userId;

      // Matches all subcollections: questionAttempts, userLevelProgresses, userTopicProgresses, studySessions
    //  match /{allSubcollections=**} {
    //    allow read, write: if request.auth != null && request.auth.uid == userId;
    //  }
    //}

  }
}